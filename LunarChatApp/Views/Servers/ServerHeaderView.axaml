<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:servers="using:LunarChatApp.ViewModels.Servers"
			 xmlns:shadui="using:ShadUI"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:Class="LunarChatApp.ServerHeaderView"
			 x:DataType="servers:ServerHeaderModel">
	<Menu Classes="Single">
		<MenuItem
		Classes="NoPressedAnimation"
		CornerRadius="{DynamicResource LgCornerRadius}"
		HorizontalAlignment="Left"
		Cursor="Hand"
		shadui:MenuItemAssist.PopupHorizontalOffset="4"
		shadui:MenuItemAssist.PopupPlacement="BottomEdgeAlignedLeft"
		shadui:MenuItemAssist.PopupVerticalOffset="4">
			<MenuItem.Header>
				<Button Padding="6,0,6,0" HorizontalAlignment="Stretch" IsHitTestVisible="False">
					<Grid ColumnSpacing="6" ColumnDefinitions="*, auto">
						<TextBlock Classes="h6" Text="{Binding Name}" TextWrapping="WrapWithOverflow"></TextBlock>
						<materialIcons:MaterialIcon Grid.Column="1" HorizontalAlignment="Right" Kind="KeyboardArrowDown" Width="16" Height="16" Foreground="{DynamicResource PrimaryColor}" />
					</Grid>
				</Button>
			</MenuItem.Header>
			<MenuItem Header="Server Settings" Width="160" Command="{Binding OpenServerSettingsCommand}" IsVisible="{Binding CanViewSettings}">
				<MenuItem.Icon>
					<materialIcons:MaterialIcon Kind="Settings" Width="12" Height="12" Foreground="{DynamicResource PrimaryColor}" />
				</MenuItem.Icon>
			</MenuItem>
			<MenuItem Header="Create Channel" Width="160" Command="{Binding CreateChannelCommand}" IsVisible="{Binding CanManageChannels}">
				<MenuItem.Icon>
					<materialIcons:MaterialIcon Kind="Add" Width="12" Height="12" Foreground="{DynamicResource PrimaryColor}" />
				</MenuItem.Icon>
			</MenuItem>
			<MenuItem Header="Report Server" Width="160" Command="{Binding OpenReportServerCommand}">
				<MenuItem.Icon>
					<materialIcons:MaterialIcon Kind="AlertCircle" Width="12" Height="12" Foreground="{DynamicResource PrimaryColor}" />
				</MenuItem.Icon>
			</MenuItem>
			<MenuItem Header="Change Nickname" Width="160" Command="{Binding ChangeNicknameCommand}" IsVisible="{Binding CanChangeNickname}">
				<MenuItem.Icon>
					<materialIcons:MaterialIcon Kind="Pencil" Width="12" Height="12" Foreground="{DynamicResource PrimaryColor}" />
				</MenuItem.Icon>
			</MenuItem>
			<MenuItem Header="Copy Server ID" Width="160" Command="{Binding CopyServerID}">
				<MenuItem.Icon>
					<materialIcons:MaterialIcon Kind="ContentCopy" Width="12" Height="12" Foreground="{DynamicResource PrimaryColor}" />
				</MenuItem.Icon>
			</MenuItem>
			<MenuItem Header="Leave Server" Width="160" Command="{Binding LeaveServerCommand}" IsVisible="{Binding !IsOwner}">
				<MenuItem.Icon>
					<materialIcons:MaterialIcon Kind="Logout" Width="12" Height="12" Foreground="{DynamicResource ErrorColor}" />
				</MenuItem.Icon>
			</MenuItem>
		</MenuItem>
	</Menu>
</UserControl>
