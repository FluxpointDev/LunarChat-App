<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:local="using:LunarChatApp"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:settings="using:LunarChatApp.Views.Servers.Settings"
             xmlns:shadui="using:ShadUI"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:Class="LunarChatApp.ServerSettingsBans"
			 x:DataType="settings:ServerSettingsBansModel">
	<ScrollViewer HorizontalScrollBarVisibility="Auto">
        <StackPanel
            Width="600"
            HorizontalAlignment="Left"
            Spacing="16">
            <Grid ColumnDefinitions="* Auto">
                <TextBox
                    Width="225"
                    HorizontalAlignment="Left"
                    shadui:ControlAssist.ShowProgress="{Binding IsSearching}"
                    Classes="Clearable"
                    Text="{Binding SearchString, Mode=TwoWay}"
                    Watermark="Search bans...">
                    <TextBox.InnerRightContent>
                        <PathIcon
                            Width="16"
                            Data="{x:Static shadui:Icons.Search}"
                            Opacity="0.75" />
                    </TextBox.InnerRightContent>
                </TextBox>
            </Grid>
            <DataGrid
                x:Name="DataGrid"
                CanUserReorderColumns="False"
                CanUserSortColumns="False"
                GridLinesVisibility="Horizontal"
                ItemsSource="{Binding Items}"
                SelectionMode="Single">
                <DataGrid.Columns>
                    <!--<DataGridCheckBoxColumn Binding="{Binding IsSelected}" CanUserSort="False">
                        <DataGridCheckBoxColumn.Header>
                            <CheckBox
                                x:Name="SelectToggler"
                                Command="{Binding ToggleSelectionCommand}"
                                CommandParameter="{Binding #SelectToggler.IsChecked}"
                                IsChecked="{Binding SelectAll}" />
                        </DataGridCheckBoxColumn.Header>
                    </DataGridCheckBoxColumn>-->
                    <DataGridTextColumn
                        Binding="{Binding Name}"
                        CanUserSort="False"
                        Header="Name"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Binding="{Binding Reason}"
                        CanUserSort="False"
                        Header="Reason"
                        IsReadOnly="True" />
                </DataGrid.Columns>
            </DataGrid>
            <Grid ColumnDefinitions="* Auto">
                <TextBlock VerticalAlignment="Center" Classes="Small Muted">
                    <Run Text="{Binding SelectedCount}" />
                    <Run Text="of" />
                    <Run Text="{Binding TotalCount}" />
                    <Run Text="row(s) selected." />
                </TextBlock>
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button Classes="Outline" IsEnabled="False">Previous</Button>
                    <Button Classes="Outline" IsEnabled="False">Next</Button>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
