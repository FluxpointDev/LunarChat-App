<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:controls="using:Avalonia.Labs.Controls"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:lunarchatsharp="using:LunarChatSharp"
			 xmlns:materialIcons="using:Material.Icons.Avalonia"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:settings="using:LunarChatApp.ViewModels.Servers.Settings"
			 xmlns:shadui="using:ShadUI"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:Class="LunarChatApp.ServerSettingsOverview"
			 x:DataType="settings:ServerSettingsOverviewModel">
	<StackPanel Spacing="20" HorizontalAlignment="Left">
		<StackPanel HorizontalAlignment="Left" Spacing="10">
			<TextBox MaxLength="{Binding Source={x:Static lunarchatsharp:Static.MaxNameLength}}"
					 Classes="Clearable"
					 Watermark=""
					 Width="225"
					 IsReadOnly="{Binding !CanManage}"
					 Text="{Binding ServerNameEdit}"
					 shadui:ControlAssist.Label="Server Name" />
		</StackPanel>
		<StackPanel
		HorizontalAlignment="Left"
		Orientation="Horizontal"
		Spacing="8">
			<Button Command="{Binding SaveSettingsCommand}" IsEnabled="{Binding CanManage}"
					Classes="Primary"
					Content="Update" />
			<Button Command="{Binding DeleteServerCommand}" IsEnabled="{Binding CanManage}"
					Classes="Destructive"
					Content="Delete Server" />
		</StackPanel>
		<StackPanel Spacing="10" HorizontalAlignment="Left">
			<Label Classes="Small">Icon</Label>
			<Border HorizontalAlignment="Left" CornerRadius="90" ClipToBounds="True" Width="90" Height="90"
					BorderBrush="{DynamicResource BorderColor}" BorderThickness="2">
				<Grid>
					<controls:AsyncImage CornerRadius="90" Source="{Binding ServerIcon}" IsVisible="{Binding ServerIcon, Converter={x:Static ObjectConverters.IsNotNull}}"></controls:AsyncImage>
					<Button Opacity="0.6" Command="{Binding UploadIconCommand}" IsEnabled="{Binding CanManage}" CornerRadius="90" />
					<materialIcons:MaterialIcon VerticalAlignment="Center" HorizontalAlignment="Center" Kind="Plus" Width="14" Height="14" IsHitTestVisible="False" Foreground="{DynamicResource PrimaryColor}" IsVisible="{Binding ServerIcon, Converter={x:Static ObjectConverters.IsNull}}" />
				</Grid>
			</Border>

			<StackPanel
			HorizontalAlignment="Left"
			Orientation="Horizontal"
			Spacing="8">
				<Button Command="{Binding ClearIconCommand}" IsEnabled="{Binding CanManage}"
						Classes="Primary"
						Content="Clear" />
			</StackPanel>

			<StackPanel Spacing="10" HorizontalAlignment="Left">
				<Label Classes="Small">Banner</Label>
				<Border VerticalAlignment="Top" CornerRadius="8" ClipToBounds="True" Width="200" Height="90"
						BorderBrush="{DynamicResource BorderColor}" BorderThickness="2">
					<Grid>
						<controls:AsyncImage CornerRadius="8" Source="{Binding ServerIcon}" IsVisible="{Binding Banner, Converter={x:Static ObjectConverters.IsNotNull}}"></controls:AsyncImage>
						<Button Opacity="0.6" Command="{Binding UploadBannerCommand}" IsEnabled="{Binding CanManage}" CornerRadius="8" />
						<materialIcons:MaterialIcon VerticalAlignment="Center" HorizontalAlignment="Center" Kind="Plus" Width="14" Height="14" IsHitTestVisible="False" Foreground="{DynamicResource PrimaryColor}" IsVisible="{Binding Banner, Converter={x:Static ObjectConverters.IsNull}}" />
					</Grid>
				</Border>

				<StackPanel
				HorizontalAlignment="Left"
				Orientation="Horizontal"
				Spacing="8">
					<Button Command="{Binding ClearBannerCommand}" IsEnabled="{Binding CanManage}"
							Classes="Primary"
							Content="Clear" />
				</StackPanel>
			</StackPanel>
		</StackPanel>
	</StackPanel>
</UserControl>
