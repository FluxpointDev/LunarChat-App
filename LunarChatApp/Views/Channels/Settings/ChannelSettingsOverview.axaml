<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:settings="using:LunarChatApp.ViewModels.Channels.Settings"
             xmlns:shadui="using:ShadUI"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:Class="LunarChatApp.ChannelSettingsOverview"
			 x:DataType="settings:ChannelSettingsOverviewModel">
	<StackPanel Spacing="20" HorizontalAlignment="Left">
		<StackPanel HorizontalAlignment="Left" Spacing="10">
			<TextBox
		Classes="Clearable"
		Watermark=""
		Width="225"
		Text="{Binding ChannelNameEdit}"
		shadui:ControlAssist.Label="Channel Name" />

			<TextBox
		Classes="Clearable"
		Watermark=""
		Width="225"
		Text="{Binding ChannelTopicEdit}"
		VerticalContentAlignment="Top"
		shadui:ControlAssist.Height="200"
		shadui:ControlAssist.Label="Channel Topic" />
		</StackPanel>
		<StackPanel
		HorizontalAlignment="Left"
		Orientation="Horizontal"
		Spacing="8">
			<Button Command="{Binding UpdateChannelCommand}"
			Classes="Primary"
			Content="Update" />
			<Button Command="{Binding DeleteChannelCommand}"
					Classes="Destructive"
					Content="Delete Channel" />
		</StackPanel>
	</StackPanel>
</UserControl>
