<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:avrichtextbox="using:AvRichTextBox"
			 xmlns:components="using:LunarChatApp.Components"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:local="using:LunarChatApp"
			 xmlns:lunarchatsharp="using:LunarChatSharp"
			 xmlns:materialIcons="using:Material.Icons.Avalonia"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:shadui="using:ShadUI"
			 xmlns:viewmodels="using:LunarChatApp.ViewModels"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:Class="LunarChatApp.ChannelView"
			 x:DataType="viewmodels:ChannelViewModel">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<Border Height="48" Grid.Row="0" BorderBrush="{DynamicResource BorderColor30}" BorderThickness="0,0,0,1">
			<Grid ColumnDefinitions="auto, auto, *, auto, auto, auto" Margin="6,4,6,5" ColumnSpacing="1" MaxHeight="48">
				<Button MinWidth="46" Command="{Binding ExpandChannelsCommand}">
					<StackPanel Orientation="Horizontal" Spacing="4">
						<materialIcons:MaterialIcon Kind="KeyboardArrowLeft" IsVisible="{Binding IsChannelsExpanded}" Width="10" Height="10" Foreground="{DynamicResource MutedColor}" />
						<materialIcons:MaterialIcon Kind="KeyboardArrowRight" IsVisible="{Binding !IsChannelsExpanded}" Width="10" Height="10" Foreground="{DynamicResource MutedColor}" />
						<materialIcons:MaterialIcon Kind="Hashtag" Width="18" Height="18" Foreground="{DynamicResource MutedColor}" />
					</StackPanel>
				</Button>
				<Menu Classes="Single" Grid.Column="1">
					<MenuItem Height="38"
							  Classes="NoPressedAnimation"
							  CornerRadius="{DynamicResource LgCornerRadius}"
							  Padding="14,2,14,0"
							  Cursor="Hand" VerticalAlignment="Top"
							  shadui:MenuItemAssist.PopupHorizontalOffset="4"
							  shadui:MenuItemAssist.PopupPlacement="BottomEdgeAlignedLeft"
							  shadui:MenuItemAssist.PopupVerticalOffset="4">
						<MenuItem.Header>
							<Button IsHitTestVisible="False">
								<TextBlock Classes="Large" Text="{Binding Name}"></TextBlock>
							</Button>
						</MenuItem.Header>
						<MenuItem Header="Edit Group Name" Width="160" Command="{Binding ChangeGroupNameCommand}" IsVisible="{Binding CanChangeName}">
							<MenuItem.Icon>
								<materialIcons:MaterialIcon Kind="Pencil" Width="12" Height="12" Foreground="{DynamicResource PrimaryColor}" />
							</MenuItem.Icon>
						</MenuItem>
						<MenuItem Header="Edit Channel" Width="160" Command="{Binding GroupSettingsCommand}" IsVisible="{Binding CanChangeName}">
							<MenuItem.Icon>
								<materialIcons:MaterialIcon Kind="Settings" Width="12" Height="12" Foreground="{DynamicResource PrimaryColor}" />
							</MenuItem.Icon>
						</MenuItem>
						<MenuItem Header="Create Invite" Width="160" Command="{Binding CreateInviteCommand}" IsVisible="{Binding CanInvite}">
							<MenuItem.Icon>
								<materialIcons:MaterialIcon Kind="Plus" Width="12" Height="12" Foreground="{DynamicResource SuccessColor}" />
							</MenuItem.Icon>
						</MenuItem>
						<MenuItem Header="Add Friend" Width="160" Command="{Binding AddFriendCommand}" IsVisible="{Binding CanAddFriend}">
							<MenuItem.Icon>
								<materialIcons:MaterialIcon Kind="Plus" Width="12" Height="12" Foreground="{DynamicResource SuccessColor}" />
							</MenuItem.Icon>
						</MenuItem>
						<MenuItem Header="Edit Channel" Width="160" Command="{Binding ChannelSettingsCommand}" IsVisible="{Binding CanManage}">
							<MenuItem.Icon>
								<materialIcons:MaterialIcon Kind="Settings" Width="12" Height="12" Foreground="{DynamicResource PrimaryColor}" />
							</MenuItem.Icon>
						</MenuItem>
						<MenuItem Header="Delete Channel" Width="160" Command="{Binding DeleteChannelCommand}" IsVisible="{Binding CanDelete}">
							<MenuItem.Icon>
								<materialIcons:MaterialIcon Kind="TrashCan" Width="12" Height="12" Foreground="{DynamicResource ErrorColor}" />
							</MenuItem.Icon>
						</MenuItem>
						<MenuItem Header="Leave Group" Width="160" Command="{Binding LeaveGroupCommand}" IsVisible="{Binding CanLeaveGroup}">
							<MenuItem.Icon>
								<materialIcons:MaterialIcon Kind="Logout" Width="12" Height="12" Foreground="{DynamicResource ErrorColor}" />
							</MenuItem.Icon>
						</MenuItem>
						<MenuItem Header="Copy Channel ID" Width="160" Command="{Binding CopyChannelID}">
							<MenuItem.Icon>
								<materialIcons:MaterialIcon Kind="ContentCopy" Width="12" Height="12" Foreground="{DynamicResource PrimaryColor}" />
							</MenuItem.Icon>
						</MenuItem>
					</MenuItem>
				</Menu>
				<Button Grid.Column="2" HorizontalContentAlignment="Left" Padding="10,0,10,2" Command="{Binding OpenTopicCommand}">
					<TextBlock Classes="p" Foreground="{DynamicResource MutedColor}" Text="{Binding Topic}"></TextBlock>
				</Button>
				<Button Grid.Column="3" Width="46" IsVisible="False">
					<StackPanel Orientation="Horizontal" Spacing="4">
						<materialIcons:MaterialIcon Kind="Pin" Width="18" Height="18" Foreground="{DynamicResource MutedColor}" />
					</StackPanel>
				</Button>
				<Button Grid.Column="4" Width="46" Command="{Binding ToggleExpandMembersCommand}">
					<StackPanel Orientation="Horizontal" Spacing="4">
						<materialIcons:MaterialIcon Kind="Accounts" Width="18" Height="18" Foreground="{DynamicResource MutedColor}" />
						<materialIcons:MaterialIcon Kind="KeyboardArrowRight" IsVisible="{Binding ExpandMembers}" Width="10" Height="10" Foreground="{DynamicResource MutedColor}" />
						<materialIcons:MaterialIcon Kind="KeyboardArrowLeft" IsVisible="{Binding !ExpandMembers}" Width="10" Height="10" Foreground="{DynamicResource MutedColor}" />
					</StackPanel>
				</Button>
				<Panel IsVisible="{OnPlatform Default=true, Android=false, iOS=false}" MinWidth="240" Grid.Column="5"></Panel>
			</Grid>
		</Border>
		<Grid Grid.Row="1" Grid.ColumnDefinitions="*, auto">
			<Grid Grid.RowDefinitions="*, auto">
				<ScrollViewer Margin="10,10,10,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
					<!--<Interaction.Behaviors>
					<components:ScrollToEndBehavior />
					</Interaction.Behaviors>-->
					<ItemsRepeater ItemsSource="{Binding CrockeryList}">
						<ItemsRepeater.Layout>
							<StackLayout Spacing="12" />
						</ItemsRepeater.Layout>
					</ItemsRepeater>
				</ScrollViewer>
				<Border Grid.Row="1" CornerRadius="8" Margin="6" Background="{DynamicResource BorderColor}">
					<Grid Margin="2, 8, 2, 8" ColumnSpacing="6">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="auto" />
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="auto" />
						</Grid.ColumnDefinitions>
						<Button Command="{Binding PasteImageCommand}" IsVisible="False" HotKey="Ctrl+v" />
						<Menu Classes="Single" VerticalAlignment="Center">
							<MenuItem
							Classes="NoPressedAnimation"
							CornerRadius="{DynamicResource LgCornerRadius}"
							HorizontalAlignment="Left" Margin="4,0,0,0" Padding="4"
							Cursor="Hand" Height="32" VerticalAlignment="Center"
							shadui:MenuItemAssist.PopupPlacement="TopEdgeAlignedLeft"
							shadui:MenuItemAssist.PopupVerticalOffset="0">
								<MenuItem.Header>
									<Button VerticalAlignment="Center" IsHitTestVisible="False">
										<materialIcons:MaterialIcon Kind="Add" Width="22" Height="22" Foreground="{DynamicResource PrimaryColor}" />
									</Button>
								</MenuItem.Header>
								<MenuItem Header="Upload Image" Width="160" Command="{Binding OpenFilePickerCommand}" IsVisible="{Binding CanSend}">
									<MenuItem.Icon>
										<materialIcons:MaterialIcon Kind="Upload" Width="12" Height="12" Foreground="{DynamicResource PrimaryColor}" />
									</MenuItem.Icon>
								</MenuItem>
							</MenuItem>
						</Menu>
						<TextBox Name="ChatBox" Grid.Column="1" Classes="" AcceptsReturn="True" IsEnabled="{Binding CanSend}"
								 MaxLength="{Binding Source={x:Static lunarchatsharp:Static.MaxMessageContentLength}}"
								 shadui:ControlAssist.MaxHeight="100" IsVisible="{Binding !InTimeout}"
								 Text="{Binding Textbox}">
							<TextBox.KeyBindings>
								<KeyBinding Command="{Binding EnterCommand}" Gesture="Enter" />
								<KeyBinding Command="{Binding ClearCommand}" Gesture="Delete" />
							</TextBox.KeyBindings>
						</TextBox>
						<TextBox Grid.Column="1" Classes="" IsEnabled="False"
								 shadui:ControlAssist.MaxHeight="100" IsVisible="{Binding InTimeout}"
								 Text="You have been timed out">
						</TextBox>
						<!--<avrichtextbox:RichTextBox Grid.Column="1" x:Name="RichBox" Background="#393A41" BorderBrush="Transparent"></avrichtextbox:RichTextBox>-->
						<Button Name="EmojiMenuButton" Grid.Column="2" Margin="0, 0, 4, 0" VerticalAlignment="Center" Padding="4">
							<!--<Button.Flyout>
								<Flyout Placement="TopEdgeAlignedRight" VerticalOffset="-16">
									<ContentControl Content="{Binding state.EmojisMenu}" IsVisible="{Binding state.EmojisMenu, Converter={x:Static ObjectConverters.IsNotNull}}"></ContentControl>
								</Flyout>
							</Button.Flyout>-->
							<materialIcons:MaterialIcon Kind="Smiley" Width="22" Height="22" Foreground="{DynamicResource PrimaryColor}" />
						</Button>
					</Grid>
				</Border>
			</Grid>
			<shadui:Sidebar Grid.Column="1"
							BorderBrush="{DynamicResource BorderColor30}"
							BorderThickness="1,0,0,0"
							MinWidth="0"
							Expanded="{Binding ExpandMembers}"
							Padding="4"
							Width="240">
				<shadui:Sidebar.Header>
					<StackPanel Orientation="Horizontal">

					</StackPanel>
				</shadui:Sidebar.Header>
				<Grid>
				</Grid>
			</shadui:Sidebar>
		</Grid>
	</Grid>
</UserControl>
