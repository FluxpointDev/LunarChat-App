<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:channels="using:LunarChatApp.Views.Channels"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:Class="LunarChatApp.CategoryItem"
			 x:DataType="channels:CategoryItemModel">

	<StackPanel>
		<Grid Margin="6,0" ColumnDefinitions="*, auto" ColumnSpacing="4" IsVisible="{Binding Name, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
			<Button HorizontalContentAlignment="Left" CornerRadius="4" Padding="10,2" Command="{Binding ToggleCategoryCommand}">
				<Grid ColumnDefinitions="*, auto" ColumnSpacing="8">
					<TextBlock FontSize="15" Text="{Binding Name}" Foreground="{DynamicResource MutedColor}"></TextBlock>
					<materialIcons:MaterialIcon Margin="0,3,0,0" Grid.Column="1" Kind="{Binding ArrowIcon}" Width="12" Height="12" Foreground="{DynamicResource MutedColor}" />
				</Grid>
			</Button>
			<Button Grid.Column="2" Padding="2" CornerRadius="4" Command="{Binding CreateChannelCommand}">
				<materialIcons:MaterialIcon Kind="Plus" Width="14" Height="14" Foreground="{DynamicResource MutedColor}" />
			</Button>
		</Grid>
		<ItemsRepeater ItemsSource="{Binding ChannelsList}" Margin="2,6">
			<ItemsRepeater.Layout>
				<StackLayout Spacing="2" />
			</ItemsRepeater.Layout>
		</ItemsRepeater>
	</StackPanel>
</UserControl>
