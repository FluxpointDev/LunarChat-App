<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:developer="using:LunarChatApp.Views.User.Settings.Developer"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:shadui="using:ShadUI"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:Class="LunarChatApp.DevItem"
			 x:DataType="developer:DevItemModel">
	<Button Width="150" Height="130" Margin="0" Padding="0" HorizontalAlignment="Left" Command="{Binding SelectCommand}">
		<shadui:Card Width="150" Height="130" Margin="0" Padding="4" HorizontalAlignment="Center" HasShadow="False">
			<shadui:Card.Header>
				<shadui:Avatar Height="60" Width="60" Fallback="{Binding Fallback}"></shadui:Avatar>
			</shadui:Card.Header>
			<TextBlock Margin="4,0,4,0" HorizontalAlignment="Center" Text="{Binding Name}"></TextBlock>
		</shadui:Card>
	</Button>
</UserControl>
