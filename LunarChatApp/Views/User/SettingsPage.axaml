<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:local="using:LunarChatApp"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:shadui="using:ShadUI"
			 xmlns:viewmodels="using:LunarChatApp.ViewModels"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:Class="LunarChatApp.SettingsPage"
			 x:DataType="viewmodels:SettingsModel">

	<Grid ColumnDefinitions="Auto *">
		<shadui:Sidebar
		BorderBrush="{DynamicResource BorderColor30}"
		BorderThickness="0,0,1,0"
		Expanded="true"
		Grid.Row="0"
		MinWidth="60"
		Padding="4"
		Width="220">
			<shadui:Sidebar.Header>
				<StackPanel>
					<TextBlock Classes="Large" HorizontalAlignment="Center" Text="Settings"></TextBlock>
				</StackPanel>
			</shadui:Sidebar.Header>
			<StackPanel Spacing="2">
				<shadui:SidebarItemLabel AsSeparator="True" Text="My Account" />
				<shadui:SidebarItem Content="Account" IsChecked="true" Command="{Binding OpenAccountCommand}">
					<shadui:SidebarItem.Icon>
						<Viewbox>
							<materialIcons:MaterialIcon Kind="Account" Width="16" Height="16" Foreground="{DynamicResource PrimaryColor}" />
						</Viewbox>
					</shadui:SidebarItem.Icon>
				</shadui:SidebarItem>
				<shadui:SidebarItem Content="Profile" Command="{Binding OpenProfileCommand}">
					<shadui:SidebarItem.Icon>
						<Viewbox>
							<materialIcons:MaterialIcon Kind="AccountEdit" Width="16" Height="16" Foreground="{DynamicResource PrimaryColor}" />
						</Viewbox>
					</shadui:SidebarItem.Icon>
				</shadui:SidebarItem>
				<shadui:SidebarItem Content="Social" Command="{Binding OpenSocialCommand}">
					<shadui:SidebarItem.Icon>
						<Viewbox>
							<materialIcons:MaterialIcon Kind="ShieldAccount" Width="16" Height="16" Foreground="{DynamicResource PrimaryColor}" />
						</Viewbox>
					</shadui:SidebarItem.Icon>
				</shadui:SidebarItem>
				<shadui:SidebarItem Content="Connections" Command="{Binding OpenConnectionsCommand}">
					<shadui:SidebarItem.Icon>
						<Viewbox>
							<materialIcons:MaterialIcon Kind="Link" Width="16" Height="16" Foreground="{DynamicResource PrimaryColor}" />
						</Viewbox>
					</shadui:SidebarItem.Icon>
				</shadui:SidebarItem>

				<shadui:SidebarItemLabel AsSeparator="True" Text="Appearance" />
				<shadui:SidebarItem Content="Theme" Command="{Binding OpenThemeCommand}">
					<shadui:SidebarItem.Icon>
						<Viewbox>
							<materialIcons:MaterialIcon Kind="FormatPaint" Width="16" Height="16" Foreground="{DynamicResource PrimaryColor}" />
						</Viewbox>
					</shadui:SidebarItem.Icon>
				</shadui:SidebarItem>
				<shadui:SidebarItem Content="Chat" Command="{Binding OpenChatCommand}">
					<shadui:SidebarItem.Icon>
						<Viewbox>
							<materialIcons:MaterialIcon Kind="Chat" Width="16" Height="16" Foreground="{DynamicResource PrimaryColor}" />
						</Viewbox>
					</shadui:SidebarItem.Icon>
				</shadui:SidebarItem>
				<shadui:SidebarItemLabel AsSeparator="True" Text="App" />
				<shadui:SidebarItem Content="Notifications" Command="{Binding OpenNotificationsCommand}">
					<shadui:SidebarItem.Icon>
						<Viewbox>
							<materialIcons:MaterialIcon Kind="Notifications" Width="16" Height="16" Foreground="{DynamicResource PrimaryColor}" />
						</Viewbox>
					</shadui:SidebarItem.Icon>
				</shadui:SidebarItem>
				<shadui:SidebarItem Content="Developer" Command="{Binding OpenDeveloperCommand}">
					<shadui:SidebarItem.Icon>
						<Viewbox>
							<materialIcons:MaterialIcon Kind="Code" Width="16" Height="16" Foreground="{DynamicResource PrimaryColor}" />
						</Viewbox>
					</shadui:SidebarItem.Icon>
				</shadui:SidebarItem>
				<shadui:SidebarItem Content="Debug" Command="{Binding OpenDebugCommand}" IsVisible="{Binding DevMode}">
					<shadui:SidebarItem.Icon>
						<Viewbox>
							<materialIcons:MaterialIcon Kind="Bug" Width="16" Height="16" Foreground="{DynamicResource PrimaryColor}" />
						</Viewbox>
					</shadui:SidebarItem.Icon>
				</shadui:SidebarItem>
				<shadui:SidebarItem Content="Streamer Mode" Command="{Binding OpenStreamerModeCommand}">
					<shadui:SidebarItem.Icon>
						<Viewbox>
							<materialIcons:MaterialIcon Kind="TelevisionPlay" Width="16" Height="16" Foreground="{DynamicResource PrimaryColor}" />
						</Viewbox>
					</shadui:SidebarItem.Icon>
				</shadui:SidebarItem>
			</StackPanel>
		</shadui:Sidebar>
		<Grid Grid.Column="1" Margin="6" MaxWidth="800" RowDefinitions="auto, *">
			<Grid Grid.ColumnDefinitions="*, auto">
				<TextBlock Classes="Large" Text="{Binding SelectedTitle}"></TextBlock>
				<Button Command="{Binding CloseSettingsCommand}" HorizontalAlignment="Right">
					<materialIcons:MaterialIcon Kind="CancelCircleOutline" Width="30" Height="30" Foreground="{DynamicResource PrimaryColor}" />
				</Button>
			</Grid>
			<ScrollViewer Grid.Row="1" Content="{Binding SelectedPage}" Margin="0,20,0,0" Padding="6,0,20,0">
			</ScrollViewer>
		</Grid>
	</Grid>
</UserControl>
