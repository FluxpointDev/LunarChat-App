<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:controls="using:Avalonia.Labs.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:messages="using:LunarChatApp.Views.Messages"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="LunarChatApp.ImageItem"
             x:DataType="messages:ImageItemModel">
    <Button Command="{Binding OpenImageCommand}" CornerRadius="2">
		<controls:AsyncImage MaxWidth="290" MaxHeight="150" Stretch="Fill" Source="{Binding Source}"></controls:AsyncImage>
    </Button>
</UserControl>
