<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:dialogs="using:LunarChatApp.ViewModels.Dialogs"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shadui="using:ShadUI"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:Class="LunarChatApp.StatusDialog"
			 x:DataType="dialogs:StatusDialogModel">
	<StackPanel Spacing="10" HorizontalAlignment="Left" Margin="10">
		<ComboBox Width="225" shadui:ControlAssist.Label="Type" SelectedIndex="{Binding StatusType}">
			<ComboBoxItem>Online</ComboBoxItem>
			<ComboBoxItem>Idle</ComboBoxItem>
			<ComboBoxItem>Focus</ComboBoxItem>
			<ComboBoxItem>Do Not Disturb</ComboBoxItem>
			<ComboBoxItem>Invisible</ComboBoxItem>
		</ComboBox>
		<TextBox
		Width="225"
		shadui:ControlAssist.Label="Text"
		Classes="Clearable"
		Text="{Binding StatusText}"
		Watermark="" />
	</StackPanel>
</UserControl>
