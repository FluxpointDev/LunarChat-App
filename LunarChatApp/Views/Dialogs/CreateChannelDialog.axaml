<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:dialogs="using:LunarChatApp.ViewModels.Dialogs"
             xmlns:lunarchatsharp="using:LunarChatSharp"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:shadui="using:ShadUI"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:Class="LunarChatApp.CreateChannelDialog"
			 x:DataType="dialogs:CreateChannelDialogModel">
	<StackPanel Spacing="10" HorizontalAlignment="Left" Margin="10">
		<TextBox MaxLength="{Binding Source={x:Static lunarchatsharp:Static.MaxNameLength}}"
		Width="225"
		shadui:ControlAssist.Label="Name"
		Classes="Clearable"
		Text="{Binding Name}"
		Watermark="">
			<TextBox.KeyBindings>
								<KeyBinding Command="{Binding SubmitCommand}" Gesture="Enter" />
							</TextBox.KeyBindings>
			</TextBox>
		<TextBox MaxLength="{Binding Source={x:Static lunarchatsharp:Static.MaxDescriptionLength}}"
		Width="225"
		shadui:ControlAssist.Label="Topic"
		Classes="Clearable"
		Text="{Binding Topic}"
		Watermark="">
			</TextBox>
		<ComboBox Width="225" shadui:ControlAssist.Label="Type" SelectedIndex="{Binding Type}">
			<ComboBoxItem>Text</ComboBoxItem>
			<ComboBoxItem>Voice</ComboBoxItem>
		</ComboBox>
	</StackPanel>
</UserControl>
