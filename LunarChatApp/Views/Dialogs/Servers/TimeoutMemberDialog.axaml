<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lunarchatsharp="using:LunarChatSharp"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:servers="using:LunarChatApp.Views.Dialogs.Servers"
             xmlns:shadui="using:ShadUI"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="LunarChatApp.TimeoutMemberDialog"
             x:DataType="servers:TimeoutMemberDialogModel">
  <StackPanel Spacing="10" HorizontalAlignment="Left" Margin="10">
      <ComboBox Width="255" SelectedIndex="{Binding SelectedTimeoutIndex}" shadui:ControlAssist.Label="Timeout">
			<ComboBoxItem>10 Minutes</ComboBoxItem>
			<ComboBoxItem>30 Minutes</ComboBoxItem>
			<ComboBoxItem>1 Hour</ComboBoxItem>
			<ComboBoxItem>5 Hours</ComboBoxItem>
			<ComboBoxItem>1 Day</ComboBoxItem>
			<ComboBoxItem>3 Days</ComboBoxItem>
			<ComboBoxItem>7 Days</ComboBoxItem>
		</ComboBox>

      <TextBox MaxLength="{Binding Source={x:Static lunarchatsharp:Static.MaxDescriptionLength}}"
		Width="255" AcceptsReturn="True"
		shadui:ControlAssist.Height="100"
		shadui:ControlAssist.Label="Reason"
		Text="{Binding Reason}"
		Watermark="" />
	</StackPanel>
</UserControl>
