<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dialogs="using:LunarChatApp.Views.Dialogs"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:md="using:LiveMarkdown.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="LunarChatApp.ChannelTopicDialog"
             x:DataType="dialogs:ChannelTopicDialogModel">
  <md:MarkdownRenderer MarkdownBuilder="{Binding Text}" InlineHyperlinkCommand="{Binding LinkClicked}" />
</UserControl>
