<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dialogs="using:LunarChatApp.Views.Dialogs"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shadui="using:ShadUI"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="LunarChatApp.CreateNameDialog"
			 x:DataType="dialogs:CreateNameDialogModel">
  <StackPanel Spacing="10" HorizontalAlignment="Left" Margin="10">
		<TextBox
		Width="225"
		shadui:ControlAssist.Label="Name"
		Classes="Clearable"
		Text="{Binding Name}"
		Watermark="" />
	</StackPanel>
</UserControl>
