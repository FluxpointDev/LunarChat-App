<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dialogs="using:LunarChatApp.Views.Dialogs"
             xmlns:lunarchatsharp="using:LunarChatSharp"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shadui="using:ShadUI"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="LunarChatApp.AddFriendDialog"
			 x:DataType="dialogs:AddFriendDialogModel">
  <StackPanel Spacing="10" HorizontalAlignment="Left" Margin="10">
		
		<TextBox MaxLength="{Binding Source={x:Static lunarchatsharp:Static.MaxNameLength}}"
		Width="225"
		shadui:ControlAssist.Label="Username"
		Classes="Clearable"
		Text="{Binding Username}"
		Watermark="" />
	</StackPanel>
</UserControl>
