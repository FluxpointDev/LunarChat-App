<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="LunarChatApp.DiscoveryHeader">
    <StackPanel Orientation="Horizontal" Margin="20,10,0,0" Spacing="10">
        <materialIcons:MaterialIcon Kind="Compass" Width="24" Height="24" Foreground="{DynamicResource PrimaryColor}" />
		<TextBlock Classes="Large" Margin="0,4,0,0" Text="Discovery"></TextBlock>
    </StackPanel>
</UserControl>
