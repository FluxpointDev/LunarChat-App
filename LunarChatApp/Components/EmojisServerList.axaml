<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:components="using:LunarChatApp.Components"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="LunarChatApp.EmojisServerList"
             x:DataType="components:EmojisServerListModel">
    <StackPanel>
        <TextBlock FontWeight="Bold" FontSize="18" Text="{Binding Name}"></TextBlock>
	    <ItemsRepeater ItemsSource="{Binding EmojisList}" Margin="6">
			<ItemsRepeater.Layout>
				<WrapLayout HorizontalSpacing="4" VerticalSpacing="4" />
			</ItemsRepeater.Layout>
		</ItemsRepeater>	
    </StackPanel>
</UserControl>
