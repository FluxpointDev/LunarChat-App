<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:local="using:LunarChatApp"
			 xmlns:shadui="using:ShadUI"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:servers="using:LunarChatApp.ViewModels.Servers"
			 mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="100"
			 x:Class="LunarChatApp.ChannelItem"
			 x:DataType="servers:ChannelItemViewModel">
	<shadui:SidebarItem Command="{Binding SelectChannelCommand}">
		<shadui:SidebarItem.Content>
			<Grid Grid.ColumnDefinitions="*, auto">
				<TextBlock Text="{Binding Name}"></TextBlock>
				<Button IsVisible="{Binding IsOwner}" HorizontalAlignment="Right" Command="{Binding OpenChannelSettingsCommand}">
					<materialIcons:MaterialIcon Kind="Settings" HorizontalAlignment="Right" Width="16" Height="16" Foreground="{DynamicResource PrimaryColor}" />
				</Button>
			</Grid>
		</shadui:SidebarItem.Content>
		<shadui:SidebarItem.Icon>
			<Viewbox>
				<materialIcons:MaterialIcon x:Name="Test" Kind="{Binding $parent[local:ChannelItem].ChannelIcon}" Width="16" Height="16" Foreground="{DynamicResource PrimaryColor}" />
			</Viewbox>
		</shadui:SidebarItem.Icon>
	</shadui:SidebarItem>
</UserControl>
