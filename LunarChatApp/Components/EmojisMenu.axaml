<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:components="using:LunarChatApp.Components"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 x:Class="LunarChatApp.EmojisMenu"
			 x:DataType="components:EmojisMenuModel" Padding="20">
	<ScrollViewer Height="200" Width="300">
		<ItemsRepeater ItemsSource="{Binding ServersList}">
			<ItemsRepeater.Layout>
				<StackLayout Spacing="10" />
			</ItemsRepeater.Layout>
		</ItemsRepeater>
	</ScrollViewer>
		
	<!--<WrapPanel ItemSpacing="6">
