		<Button Content="🔥" FontSize="24" Width="36" Height="36" Click="Button_Click" />
		<Button Content="🐦" FontSize="24" Width="36" Height="36" Click="Button_Click" />
		<Button Content="💥" FontSize="24" Width="36" Height="36" Click="Button_Click" />
		<Button Content="😺" FontSize="24" Width="36" Height="36" Click="Button_Click" />
	</WrapPanel>-->
</UserControl>
