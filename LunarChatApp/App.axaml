<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:LunarChatApp"
             xmlns:labs="using:Avalonia.Labs.Controls"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
             x:Class="LunarChatApp.App"
             xmlns:themes="clr-namespace:ShadUI;assembly=ShadUI"
             RequestedThemeVariant="Default">

     <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/lunar-icon.png" ToolTipText="Lunar Chat">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <!--  added spaces to have a wider menu  -->
                        <NativeMenuItem Header="Open            " />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Quit" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>

    <Application.Resources>
        <!--<FontFamily x:Key="Twemoji">avares://LunarChatApp/Assets/Fonts/Twemoji.ttf</FontFamily>-->

    </Application.Resources>

    <Application.Styles>
        <themes:ShadTheme />
        <labs:ControlThemes />
        <materialIcons:MaterialIconStyles />
        <!--<StyleInclude Source="/Assets/Styles/Markdown.axaml"/>-->
    </Application.Styles>
</Application>