<Application xmlns="https://github.com/avaloniaui"
             xmlns:dialogHostAvalonia="using:DialogHostAvalonia"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:LunarChatApp"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
             x:Class="LunarChatApp.App"
             xmlns:themes="clr-namespace:ShadUI;assembly=ShadUI"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

     <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/test-icon.ico" ToolTipText="Lunar Chat">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <!--  added spaces to have a wider menu  -->
                        <NativeMenuItem Header="Open            " />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Quit" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>

    <Application.Resources>
		<!--<FontFamily x:Key="ShadUIIcon">/Assets/Fonts#shadui</FontFamily>-->
    </Application.Resources>
    <Application.Styles>
        <themes:ShadTheme />
        <materialIcons:MaterialIconStyles />
        <StyleInclude Source="/Assets/Styles/Markdown.axaml"/>
    </Application.Styles>
</Application>